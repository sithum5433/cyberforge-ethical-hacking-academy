{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build cybersecurity reader",
			"type": "process",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": [
				"scripts/build_html_reader.py"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Serve cybersecurity reader",
			"type": "process",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": ["-u", "-m", "http.server", "8000", "--bind", "127.0.0.1"],
			"options": {"cwd": "${workspaceFolder}"},
			"isBackground": true,
			"problemMatcher": {
				"owner": "cyberforge-server",
				"pattern": {"regexp": "^(__never_a_problem__)$", "message": 1},
				"background": {"activeOnStart": true, "beginsPattern": ".*", "endsPattern": "Serving HTTP on.*"}
			}
		}
	]
}
